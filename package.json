{
  "name": "@local/dsh-browser-use",
  "version": "0.1.1",
  "description": "Browser use for DSH: browser_* agent tools that drive the built-in right-sidebar browser of the Desktop app",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
